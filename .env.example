# 認証（必須）
NEXTAUTH_SECRET=your-secret          # openssl rand -base64 32 で生成
NEXTAUTH_URL=http://localhost:3000

# データベース（任意・デフォルト lime.db）
DATABASE_URL=lime.db

# --- Salesforce連携（IP回線：Username-Password Flow） ---
SF_LOGIN_URL=https://login.salesforce.com
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_PRODUCT2_ID_CC01=
SF_PRODUCT2_ID_CC02=
SF_PRICEBOOK2_ID=

# --- Salesforce連携（携帯回線：Client Credentials Flow） ---
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_INSTANCE_URL=https://login.salesforce.com
SF_PRICEBOOK_ENTRY_ID_MOBILE=

# SF商談リンク用（例: https://your-org.my.salesforce.com）
NEXT_PUBLIC_SF_ORG_URL=

# --- SB法人コンシェル同期 ---
# アプリ内お知らせに加えてSlackへ通知する。未設定ならSlack通知はスキップされる
SLACK_WEBHOOK_URL=
# 通知内のリンクを絶対URLにするため（例: https://line-management-xxx.run.app）
APP_BASE_URL=

# Phase C（Playwrightでの日次取得）で使う。本体サービスには設定しない：
#   SB_CONCIERGE_LOGIN_URL / SB_CONCIERGE_ID / SB_CONCIERGE_PASSWORD は
#   Cloud Run Job（concierge-bot）側にのみ設定する
# CONCIERGE_JOB_NAME=concierge-bot
# CONCIERGE_JOB_REGION=asia-northeast1
# SCHEDULER_TOKEN=
